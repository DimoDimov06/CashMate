@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@{
    ViewBag.Title = "Confirm Email";
}

<head>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <div class="form-container mx-auto">
        <h2>@Localizer["Confirm"]</h2>

        <h4>@Localizer["Code"].</h4>
        <form asp-action="ConfirmEmail" method="post">
            <div class="input-group mb-3">
                <span class="input-group-text" id="basic-addon1">@Localizer["Insert"]:</span>
                @Html.TextBox("code", null, new { @class = "form-control", aria_describedby = "basic-addon1" })
            </div>
            <button type="submit" class="btn btn-primary">@Localizer["Confirm"]</button>
        </form> 
    </div>
    
            
</body>
