@using CashMate.Models.Data
@model IEnumerable<Purchase>

<head>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <div class="form-container mx-auto">

        <table class ="table">
            @{
                decimal totalDebit = 0;
                decimal totalCredit = 0;
            }
            <thead class="table-dark">
                <tr>
                    <th>Date</th>
                    <th>Debit</th>
                    <th>Credit</th>
                    <th colspan="3">Description</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var purchase in Model)
                {
                    <tr>
                        <td>@purchase.PurchaseDate.ToString("yyyy-MM-dd")</td>
                        <td class="numeric @(purchase.Debit > 0 ? "debit" : "")">@String.Format("{0:F2}", purchase.Debit)</td>
                        <td class="numeric @(purchase.Credit > 0 ? "credit" : "")">@String.Format("{0:F2}", purchase.Credit)</td>
                        <td colspan="3" style="text-align: right;">@purchase.Description</td>
                    </tr>

                    totalDebit += purchase.Debit ?? 0;
                    totalCredit += purchase.Credit ?? 0;

                }
            </tbody>
            <tfoot>
                <tr>
                    <th class="text-start">Total</th>
                    <td class="numeric">@String.Format("{0:F2}", totalDebit)</td>
                    <td class="numeric">@String.Format("{0:F2}", totalCredit)</td>
                    <td class="text-start" colspan="3"></td>
                </tr>
                
            </tfoot>
        </table>
    </div>
</body>