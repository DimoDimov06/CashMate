@using CashMate.Models.Data
@model IEnumerable<Purchase>

<head>
    <link rel="stylesheet" href="~/css/site.css" />
    <style>
        .description-cell {
        white-space: pre-wrap; /* Позволява текста да се прехвърля на нов ред */
        word-wrap: break-word; /* Позволява на думите да се прекъсват, ако са твърде дълги */
        max-width: 200px; /* Ограничава ширината на колоната */
        }
    </style>
</head>
<body>
    <div class="form-container mx-auto">
        <table class="table">
            @{

                decimal totalDebit = 0;
                decimal totalCredit = 0;
                decimal totalResult = 0;
            }
            <thead class="table-dark">
                <tr>
                    <th>Date</th>
                    <th>Debit</th>
                    <th>Credit</th>
                    <th colspan="3">Description</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var purchase in Model)
                {
                    <tr>
                        <td>@purchase.PurchaseDate.ToString("yyyy-MM-dd")</td>
                        <td class="numeric @(purchase.Debit > 0 ? "debit" : "")">@String.Format("{0:F2}", purchase.Debit)</td>
                        <td class="numeric @(purchase.Credit > 0 ? "credit" : "")">@String.Format("{0:F2}", purchase.Credit)</td>
                        <td colspan="3" class="description-cell">@purchase.Description</td>
                        <td>
                            <a href="@Url.Action("Edit", "Purchases", new { id = purchase.Id })" class="btn btn-warning">Edit</a>
                        </td>
                        <td>
                            <form asp-action="Delete" asp-controller="Purchases" method="post" onsubmit="return confirm('Are you sure you want to delete this purchase?');">
                                <input type="hidden" name="id" value="@purchase.Id" />
                                <input type="hidden" name="startDate" value="@ViewBag.StartDate" />
                                <input type="hidden" name="endDate" value="@ViewBag.EndDate" />
                                <button type="submit" class="btn btn-danger">Delete</button>
                            </form>
                        </td>
                    </tr>

                    totalDebit += purchase.Debit ?? 0;
                    totalCredit += purchase.Credit ?? 0;
                }
            </tbody>
            <tfoot>
                @{

                    totalResult = totalDebit - totalCredit;
                    <tr>
                        <th class="text-start">Total</th>
                        <td class="numeric @(totalDebit > 0 ? "debit" : "")">@String.Format("{0:F2}", totalDebit)</td>
                        <td class="numeric @(totalCredit > 0 ? "credit" : "")">@String.Format("{0:F2}", totalCredit)</td>
                        <td class="text-start" colspan="3"></td>
                    </tr>
                    <tr>
                        <th class="text-start">Result</th>
                        @if (totalResult >= 0) 
                        {
                            <td class="numeric debit">@String.Format("{0:F2}", totalResult)</td>
                            <td></td>
                        }
                        else 
                        {
                            <td></td>
                            <td class="numeric credit">@String.Format("{0:F2}", totalResult)</td>
                        }
                        <td class="text-start" colspan="3"></td>
                    </tr>
                }
            </tfoot>
        </table>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const descriptionCells = document.querySelectorAll(".description-cell");

            descriptionCells.forEach(cell => {
                const text = cell.textContent;
                const chunkSize = 30; // Брой символи на ред
                let formattedText = "";

                for (let i = 0; i < text.length; i += chunkSize) {
                    formattedText += text.slice(i, i + chunkSize) + "\n"; // Добавя нов ред след всеки 30 символа
                }

                cell.textContent = formattedText.trim(); // Премахва последния празен ред
            });
        });
    </script>
</body>