@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@{
    ViewBag.Title = "Upload XML";
}

<head>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <div class="form-container mx-auto">

        <h2>@Localizer["Upload"]</h2>
        <h2>@ViewBag.UserId</h2>


        @using (Html.BeginForm("Upload", "ReadAccountXML", FormMethod.Post, new { enctype = "multipart/form-data", @class = "needs-validation", novalidate = "novalidate" }))
        {
            <div class="mb-3">
                <label for="fileInput" class="form-label">@Localizer["Select"] file</label>
                <input type="file" class="form-control" id="fileInput" name="file" accept=".xml" required />
                <div class="invalid-feedback">
                    @Localizer["Please"].
                </div>
            </div>
            <div class="d-grid gap-2 col-6 mx-auto">
                <button class="btn btn-primary" type="submit">@Localizer["Upl"]</button>
            </div>
        }
    </div>
</body>
